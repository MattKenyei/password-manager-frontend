{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "0.0.0",
  "description": "Zero-knowledge password manager with end-to-end encryption",
  "action": {
    "default_popup": "src/extension/popup/index.html",
    "default_title": "Password Manager"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/extension/content/index.ts-loader.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "http://localhost:5173/*"
      ]
    },
    {
      "matches": [
        "http://localhost:8080/*"
      ],
      "js": [
        "vendor/crx-iife-reload-bridge.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.wasm",
        "assets/*.wasm",
        "assets/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "**/*",
        "*"
      ],
      "use_dynamic_url": false
    }
  ]
}
